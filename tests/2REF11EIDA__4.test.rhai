import "runtime_test" as runtime;

// Tests of 2REF11EIDA__4.rhai (fridge), ported from upstream rethink's test suite (commit
// 0e57069; real captures from issue #9). Expected values and writes are what upstream's driver
// publishes and sends for the same input.

fn sample_initial() { "AA4A10EB0209060202020400000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000079BB" }
fn sample_delta_door_open() { "AA8E10EC0209060202020400000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000209060202020401000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF0000FABB" }
fn sample_delta_fridge_42f() { "AA8E10EC0201060202020401000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000202060202020401000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF0000F4BB" }
fn sample_delta_flex_freezer() { "AA8E10EC0209060202020401000001FFFF0300FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000209060202020401000001FFFF0500FFFF00FFFFFFFFFFFFFF020001010100000102FF6161FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF0000E7BB" }

fn last(d) { let s = d.sent(); hex_encode_upper(s[s.len() - 1]) }

fn test_sample_initial() {
    let d = device();
    d.feed(sample_initial());
    expect_props(d, #{ door: "false", fridge_setpoint: "35", freezer_setpoint: "0", flex_setpoint: "cold_drink" });
}

fn test_sample_delta_door_open() {
    let d = device();
    d.feed(sample_delta_door_open());
    expect_props(d, #{ door: "true", fridge_setpoint: "35", freezer_setpoint: "0", flex_setpoint: "cold_drink" });
}

fn test_sample_delta_fridge_42f() {
    let d = device();
    d.feed(sample_delta_fridge_42f());
    expect_props(d, #{ door: "true", fridge_setpoint: "42", freezer_setpoint: "0", flex_setpoint: "cold_drink" });
}

fn test_sample_delta_flex_freezer() {
    let d = device();
    d.feed(sample_delta_flex_freezer());
    expect_props(d, #{ door: "true", fridge_setpoint: "35", freezer_setpoint: "0", flex_setpoint: "freezer" });
}

fn test_start() {
    let d = device();
    d.start();
    expect_eq(d.sent().len(), 1);
    if d.sent().len() > 0 { expect_eq(last(d), "AA0EF0ED1211010000010400EBBB"); }
}

fn test_writes_match_upstream() {
    let d = device();
    d.start();
    d.feed(sample_initial());
    for w in [
        ["fridge_setpoint", "38", "AA69F017FF06FFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBABB"],
        ["fridge_setpoint", "36", "AA69F017FF08FFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFA4BB"],
        ["freezer_setpoint", "-7", "AA69F017FFFF0DFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFA3BB"],
        ["freezer_setpoint", "5", "AA69F017FFFF01FFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB"],
        ["flex_setpoint", "freezer", "AA69F017FFFFFFFFFFFFFFFF00FFFFFFFF05FFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBBBB"],
        ["flex_setpoint", "chilled_wine", "AA69F017FFFFFFFFFFFFFFFF00FFFFFFFF01FFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB"],
        ["flex_setpoint", "deli_snacks", "AA69F017FFFFFFFFFFFFFFFF00FFFFFFFF02FFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBEBB"],
        ["flex_setpoint", "meat_seafood", "AA69F017FFFFFFFFFFFFFFFF00FFFFFFFF04FFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFB8BB"],
        ["flex_setpoint", "cold_drink", "AA69F017FFFFFFFFFFFFFFFF00FFFFFFFF03FFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFB9BB"],
    ] {
        d.set(w[0], w[1]);
        expect_eq(last(d), w[2]);
    }
}

fn test_unknown_and_read_only_writes_are_rejected() {
    let d = device();
    d.start();
    d.feed(sample_initial());
    let n = d.sent().len();
    d.set("does_not_exist", "1");
    d.set("door", "true");
    expect_eq(d.sent().len(), n);
    expect(d.event("reject") != (), "rejects are published");
}

fn test_other_frames_are_ignored() {
    let d = device();
    d.feed("001122");
    d.feed("AA08109901020304BB");
    expect_eq(d.property("door"), ());
}

fn test_the_fahrenheit_capture_republishes_the_descriptor() {
    let d = device();
    d.start();
    d.feed(sample_initial());
    let desc = runtime::descriptor(d);
    expect_eq(desc.props.fridge_setpoint.unit, "°F");
    expect_eq(desc.props.fridge_setpoint.max, 43);
    expect_eq(desc.props.flex_setpoint.options,
              ["chilled_wine", "deli_snacks", "cold_drink", "meat_seafood", "freezer"]);
}
