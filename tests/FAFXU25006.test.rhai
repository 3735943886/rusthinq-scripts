import "runtime_test" as runtime;

// Tests of FAFXU25006, ported from upstream rethink's test suite (commit 0e57069; live captures
// correlated against the LG cloud's decoded state). Expected values are what upstream's driver
// publishes, in IL names; LG's not-applicable dashes upstream reads as "None" are "none" here, and
// the unweighed load level is absent (an empty retained value).

fn eb_power_off() { "aaff200a005a000fa8000100eb00480aff00ffff1b0000000000000000010000007f001b001000020000ff2004ffff2d3c000000400004300000000000000400004000000000000000f00064000400000000ffff0100000e45bb" }
fn normal_idle() { "" }
fn speed_wash() { "" }
fn heavy_duty() { "" }
fn tub_clean() { "" }
fn spin_only() { "" }
fn pet_care() { "" }
fn allergy_care() { "" }
fn rinse_plus3() { "" }
fn starts_running() { "" }
fn door_locks() { "" }
fn running_countdown() { "" }
fn rinsing() { "" }
fn spinning() { "" }
fn eb_ends() { "aaff200a005a000df6000100eb00480aff00ffff54000000000000000001000000630054100e00010000ff1f04ffff2d3c000000400104300000000000000400004000000000000000f00064000400000000ffff010000bcd7bb" }
fn pauses() { "" }
fn unlocks_on_pause() { "" }
fn resumes() { "" }
fn ends() { "" }
fn unlocks_at_end() { "" }
fn powers_off() { "" }
fn delay_wash() { "" }
fn delay_starts() { "" }
fn delay_counts_down() { "" }
fn delay_fires() { "" }
fn spin_starts() { "" }
fn cycle_ends() { "" }
fn powers_off_at_end() { "" }
fn drum_light_off() { "" }
fn load_weighed() { "" }
fn auto_soak_on() { "" }
fn fresh_care_on() { "" }
fn buzzer_3() { "" }
fn buzzer_off() { "" }
fn child_lock_on() { "" }
fn remote_maintain_on() { "" }
fn detecting() { "" }
fn door_opens() { "aaff200a004900141c00020103000e610f0201610840010001000f02010105002546414658553235303036000000000000000000000102c586a2f40a09000000000000000000bd49bb" }
fn door_shuts() { "aaff200a004900141d00020103000e610f0201610841010002000f02010105002546414658553235303036000000000000000000000102c686a2f40a0900000000000000000071febb" }

fn fed(frames) { let d = device(); for f in frames { d.feed(f); } d }
fn prop_of(frames, p) { fed(frames).property(p) }

// a selected course decodes with all of its options
fn test_a_selected_course() {
    expect_props(fed([normal_idle()]), #{ power: "true", status: "standby", course: "normal", soil: "normal",
        temp: "warm", spin: "high", rinse: "normal", turbo_wash: "true", pre_wash: "false", steam: "false",
        door_lock: "false" });
}

// the minute counters are little-endian, unlike the LG dryers
fn test_little_endian_minutes() {
    expect_props(fed([normal_idle()]), #{ remaining_time: "39", initial_time: "39" });
    expect_props(fed([heavy_duty()]), #{ remaining_time: "108", initial_time: "108" });
}

// the course table covers the whole selector
fn test_the_selector() {
    expect_eq(prop_of([speed_wash()], "course"), "quick_wash");
    expect_eq(prop_of([heavy_duty()], "course"), "heavy_duty");
    expect_eq(prop_of([tub_clean()], "course"), "tub_clean");
    expect_eq(prop_of([spin_only()], "course"), "spin_only");
    expect_eq(prop_of([pet_care()], "course"), "pet_care");
    expect_eq(prop_of([allergy_care()], "course"), "allergiene");
}

// soil, temperature, spin and rinse each read from their own byte
fn test_the_settings_bytes() {
    expect_props(fed([speed_wash()]), #{ soil: "light", temp: "hot", spin: "extra_high" });
    expect_props(fed([heavy_duty()]), #{ soil: "heavy", temp: "warm" });
    expect_props(fed([pet_care()]), #{ temp: "extra_hot", spin: "medium" });
    expect_eq(prop_of([rinse_plus3()], "rinse"), "plus_3");
}

// the not-applicable sentinels report unknown rather than a bogus setting
fn test_the_not_applicable_dashes() {
    expect_props(fed([tub_clean()]), #{ soil: "none", temp: "none" });
    expect_eq(prop_of([spin_only()], "rinse"), "none");
}

// steam and pre-wash live in different bitfields and do not collide
fn test_steam_and_pre_wash() {
    expect_props(fed([tub_clean()]), #{ steam: "true", pre_wash: "false", turbo_wash: "false" });
    expect_props(fed([pet_care()]), #{ pre_wash: "true", steam: "false", turbo_wash: "false" });
    expect_props(fed([allergy_care()]), #{ steam: "true", pre_wash: "false" });
}

// turbo wash is rec[34] bit 0x20, alongside pre-wash in the same byte
fn test_turbo_wash() {
    expect_eq(prop_of([normal_idle()], "turbo_wash"), "true");
    expect_eq(prop_of([heavy_duty()], "turbo_wash"), "true");
    expect_eq(prop_of([speed_wash()], "turbo_wash"), "false");
}

// starting the cycle moves the state and then locks the door
fn test_starting_then_locking() {
    expect_props(fed([normal_idle(), starts_running()]), #{ status: "washing", door_lock: "false" });
    expect_props(fed([normal_idle(), starts_running(), door_locks()]), #{ door_lock: "true", status: "washing" });
}

// the countdown falls while the cycle length stays put, and energy accumulates
fn test_the_countdown_and_energy() {
    expect_props(fed([running_countdown()]), #{ remaining_time: "52", initial_time: "54", energy: "1" });
}

// the later phases of a cycle decode from the same byte
fn test_the_later_phases() {
    expect_eq(prop_of([rinsing()], "status"), "rinsing");
    expect_eq(prop_of([spinning()], "status"), "spinning");
}

// 0xEB single-record frames decode with the same offsets as 0xEC
fn test_single_record_frames() {
    expect_props(fed([eb_power_off()]), #{ power: "false", status: "off", course: "bedding", remaining_time: "0", energy: "127" });
    expect_eq(prop_of([eb_ends()], "status"), "end");
}

// pausing and resuming a cycle moves the state and the door lock
fn test_pause_and_resume() {
    expect_props(fed([pauses()]), #{ status: "paused", remaining_time: "5", door_lock: "true" });
    expect_props(fed([pauses(), unlocks_on_pause()]), #{ door_lock: "false", status: "paused" });
    expect_props(fed([pauses(), unlocks_on_pause(), resumes()]), #{ status: "spinning", remaining_time: "5" });
}

// the end of a cycle unlocks the door and then powers off
fn test_the_end_of_a_cycle() {
    expect_props(fed([ends()]), #{ status: "end", energy: "144", initial_time: "0", door_lock: "true" });
    expect_eq(prop_of([ends(), unlocks_at_end()], "door_lock"), "false");
    expect_props(fed([ends(), unlocks_at_end(), powers_off()]), #{ power: "false", status: "off", remaining_time: "0", energy: "144" });
}

// a Delay Wash publishes its countdown and its own flag
fn test_a_delay_wash() {
    expect_props(fed([delay_wash()]), #{ delay_wash: "true", reserve_time: "60", remaining_time: "29",
        initial_time: "29", status: "standby" });
    expect_props(fed([normal_idle()]), #{ delay_wash: "false", reserve_time: "0" });
}

// the delay counts down only once it starts, in state Reserved
fn test_the_delay_counts_down_once_started() {
    expect_eq(prop_of([delay_wash()], "status"), "standby");
    expect_props(fed([delay_wash(), delay_starts()]), #{ status: "delayed", delay_wash: "true", reserve_time: "60",
        drum_light: "false", remaining_time: "53", initial_time: "53" });
    expect_props(fed([delay_starts(), delay_counts_down()]), #{ status: "delayed", reserve_time: "30",
        remaining_time: "53", door_lock: "true" });
}

// the delay firing clears its own flag and starts the wash
fn test_the_delay_firing() {
    expect_props(fed([delay_counts_down(), delay_fires()]), #{ status: "washing", delay_wash: "false",
        reserve_time: "0", remaining_time: "53", initial_time: "53", door_lock: "true" });
}

// the dispensers are told apart by the phase each one dashes in
fn test_the_dispensers_dash() {
    expect_props(fed([spin_starts()]), #{ status: "spinning", remaining_time: "17", ez_dispense_softener: "none",
        ez_dispense_detergent: "none" });
}

// a finished cycle reports End, then powers itself off
fn test_a_finished_cycle() {
    expect_props(fed([spin_starts(), cycle_ends()]), #{ status: "end", power: "true", initial_time: "0",
        remaining_time: "1", energy: "83", drum_light: "true" });
    expect_props(fed([cycle_ends(), powers_off_at_end()]), #{ status: "off", power: "false", door_lock: "false", energy: "83" });
}

// the tub clean counter steps as a cycle ends
fn test_the_tub_clean_counter() {
    expect_eq(prop_of([spin_starts()], "tub_clean_count"), "34");
    expect_eq(prop_of([spin_starts(), cycle_ends()], "tub_clean_count"), "35");
}

// the door is announced in its own frame, not in the status record
fn test_the_door_frame() {
    expect_eq(prop_of([door_opens()], "door"), "true");
    expect_eq(prop_of([door_shuts()], "door"), "false");
    let with_status = fed([normal_idle(), door_opens()]);
    expect_props(with_status, #{ door: "true", status: "standby", course: "normal" });
    // a status record does not clear the door
    expect_eq(prop_of([door_opens(), normal_idle()], "door"), "true");
}

// the drum light is rec[37] bit 0x40
fn test_the_drum_light() {
    expect_eq(prop_of([delay_wash()], "drum_light"), "true");
    expect_props(fed([delay_wash(), drum_light_off()]), #{ drum_light: "false", energy: "1", delay_wash: "true" });
}

// the load level reports unknown until the machine has weighed it
fn test_the_load_level() {
    expect_eq(prop_of([load_weighed()], "load_level"), "2");
    // the 100 sentinel: absent, an empty retained value
    expect_eq(prop_of([normal_idle()], "load_level"), "");
    expect_eq(prop_of([load_weighed(), normal_idle()], "load_level"), "");
}

// the second settings pass isolates one option per byte
fn test_one_option_per_byte() {
    expect_props(fed([auto_soak_on()]), #{ auto_soak: "true", turbo_wash: "true", pre_wash: "false" });
    expect_props(fed([fresh_care_on()]), #{ fresh_care: "true", auto_soak: "false" });
    expect_props(fed([child_lock_on()]), #{ child_lock: "true", drum_light: "true" });
    expect_props(fed([remote_maintain_on()]), #{ remote_maintain: "true", delay_wash: "true", reserve_time: "60" });
}

// the buzzer scale and the end melody
fn test_the_buzzer_and_end_melody() {
    expect_eq(prop_of([buzzer_3()], "buzzer"), "3");
    expect_eq(prop_of([auto_soak_on()], "buzzer"), "4");
    expect_props(fed([buzzer_off()]), #{ buzzer: "off", end_melody: "false" });
    expect_eq(prop_of([buzzer_3()], "end_melody"), "true");
}

// a cycle started at the panel sensing the load reports Detecting
fn test_detecting() { expect_props(fed([detecting()]), #{ status: "detecting", course: "normal" }); }

// the EZDispense settings leave their sentinel when a cycle begins
fn test_the_ezdispense_settings() {
    expect_props(fed([normal_idle()]), #{ ez_dispense_detergent: "none", ez_dispense_softener: "none" });
    expect_props(fed([detecting()]), #{ ez_dispense_detergent: "off", ez_dispense_softener: "off" });
}

// start() requests a status snapshot, so a reconnect does not leave HA blank
fn test_start_asks_for_the_status() {
    let d = device();
    d.start();
    expect_eq(d.sent().len(), 1);
    expect_eq(hex_encode(d.sent()[0]), "aa12f0ed1121010000001804111200005ebb");
}

// frames that are not status records publish nothing
fn test_other_frames_publish_nothing() {
    for junk in ["aa07201902b9bb", "aa0720c302c3bb", "aaff200a0049000fff00020103000e610f0201",
                 "aaff200a00a2001002000100ec00900aff000e00000000bb"] {
        expect_eq(prop_of([junk], "available"), (), junk);
        expect_eq(prop_of([junk], "door"), (), junk);
    }
}
