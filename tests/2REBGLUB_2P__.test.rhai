import "runtime_test" as runtime;

// Tests of 2REBGLUB_2P__, ported from upstream rethink's test suite (commit 2d8eaba; real captures
// from a GBBSJ2CCEP through the rethink bridge, and the F0 17 commands the LG app sent). Expected
// values and writes are what upstream's driver publishes and sends for the same input, in IL names.

fn status_initial() { "AA6610EB02040401FFFFFF0201FFFFFF00FFFFFF0001FFFFFFFFFFFFFFFF050101FF02FFFFFFFFFFFFFFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0005FFFFFFFFFF0000FF00000DBB" }
fn status_door_open() { "" }
fn status_super_cool() { "" }
fn status_fresh_converter_2() { "" }
fn energy_8wh() { "AA0B10AF0000080404D1BB" }
fn usage() { "AA2010C5150401000100001203000000000011000A0000A6130000000000F6BB" }
fn firmware() { "AA37103102015341413330383830383031000068E0000018000003E8000253414133303631393030310000968F000000000000A8004CBB" }
fn app_fridge_5c() { "AA7CF017FF03FFFFFFFFFFFF01FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBBBB" }
fn app_freezer_m19c() { "AA7CF017FFFF05FFFFFFFFFF01FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFA5BB" }
fn app_express_freeze_on() { "AA7CF017FFFFFF02FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBEBB" }
fn app_vacation_on() { "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFF01FFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB" }
fn app_super_cool_on() { "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF01FFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB" }
fn app_smart_learner_off() { "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBCBB" }
fn app_fresh_converter_2() { "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF02FFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBEBB" }

fn ready() { let d = device(); d.start(); d.feed(status_initial()); d }
fn write(prop, value) { let d = ready(); let n = d.sent().len(); d.set(prop, value); d.sent().extract(n).map(|s| hex_encode_upper(s)) }

// 0x10EB initial status
fn test_the_initial_status() {
    let d = ready();
    expect_eq(runtime::descriptor(d).props.fridge_setpoint.unit, "°C");
    expect_props(d, #{ fridge_setpoint: "4", freezer_setpoint: "-18", door: "false", express_freeze: "false",
                       super_cool: "false", smart_learner: "true", vacation: "false", fresh_converter: "cheese" });
}

// 0x10EC status changes
fn test_status_changes() {
    let d = ready();
    d.feed(status_door_open());
    expect_eq(d.property("door"), "true");
    d.feed(status_super_cool());
    expect_props(d, #{ door: "false", super_cool: "true" });
    d.feed(status_fresh_converter_2());
    expect_eq(d.property("fresh_converter"), "meat");
}

// 0x10AF energy accumulates
fn test_energy_accumulates() {
    let d = ready();
    d.feed(energy_8wh());
    d.feed(energy_8wh());
    expect_eq(d.property("energy"), "16");
}

// 0x10AF energy that arrives before the unit is counted
fn test_energy_before_the_first_status() {
    let d = device();
    d.start();
    d.feed(energy_8wh());
    d.feed(status_initial());
    d.feed(energy_8wh());
    expect_eq(d.property("energy"), "16");
}

// 0x10C5 door usage totals
fn test_door_usage() {
    let d = ready();
    d.feed(usage());
    expect_props(d, #{ door_openings: "18", door_open_time: "166" });
}

// 0x1031 firmware versions
fn test_firmware() {
    let d = ready();
    d.feed(firmware());
    expect_props(d, #{ firmware_1: "68e0.0 (SAA30880801)", firmware_2: "968f.0 (SAA30619001)" });
}

// start() sends the F0ED status query
fn test_start_asks_for_the_status() {
    let d = device();
    d.start();
    expect_eq(hex_encode_upper(d.sent()[0]), "AA0EF0ED1211010000010400EBBB");
}

// HA writes reproduce the LG app commands
fn test_writes_reproduce_the_app() {
    expect_eq(write("fridge_setpoint", "5"), [app_fridge_5c()]);
    expect_eq(write("freezer_setpoint", "-19"), [app_freezer_m19c()]);
    expect_eq(write("express_freeze", "true"), [app_express_freeze_on()]);
    expect_eq(write("vacation", "true"), [app_vacation_on()]);
    expect_eq(write("super_cool", "true"), [app_super_cool_on()]);
    expect_eq(write("smart_learner", "false"), [app_smart_learner_off()]);
    expect_eq(write("fresh_converter", "meat"), [app_fresh_converter_2()]);
}

// HA write to unknown property emits no packet
fn test_an_unknown_property() {
    expect_eq(write("nonsense", "whatever"), []);
}
