// config exposes a lean component set (no inherited zombie entities); EzDispense, soil and options
fn test_the_descriptor_is_read_only_and_lean() {
    let d = device();
    d.start();
    let props = runtime::descriptor(d).props;
    for p in ["power", "status", "course", "temp", "spin", "energy", "initial_time", "remaining_time",
              "door", "child_lock", "remote_start", "cycles", "detergent_dispenser", "softener_dispenser",
              "detergent_dose", "softener_dose", "soil", "rinse", "pre_wash", "turbo_wash", "steam"] {
        expect(props.contains(p), p);
    }
    for p in ["error", "error_message", "door_lock", "start", "pause"] { expect(!props.contains(p), "no " + p); }
    expect(props.power.rw != true, "power is read only");
    expect_eq(props.door.class, "door");
    expect_eq(props.detergent_dose.unit, "ml");
}

// unknown and read-only writes are rejected
fn test_writes_are_rejected() {
    let d = device();
    d.start();
    d.set("power", "true");
    expect_eq(d.sent().len(), 0);
}

// 0x88 config frame marks power ON (settings now sourced from the status frame)
fn test_config_frame_marks_power() {
    let d = device();
    d.feed(cfg_cold());
    expect_props(d, #{ power: "true" });
}

// 0x92 status decodes course, temp, spin from record B; (Washing) decodes status, remaining, initial, power
fn test_washing() {
    let d = device();
    d.feed(washing());
    expect_props(d, #{ course: "quick_14", temp: "20", spin: "400", power: "true", status: "washing", remaining_time: "14", initial_time: "14" });
}

// 0x92 status (Drum Clean) maps step 0x29 to Drum Clean, remaining/initial = 72
fn test_drum_clean() {
    let d = device();
    d.feed(drum());
    expect_props(d, #{ status: "drum_clean", course: "drum_clean", remaining_time: "72", initial_time: "72" });
}

// 0x92 status (End) decodes status=End, remaining=0
fn test_end() {
    let d = device();
    d.feed(end());
    expect_props(d, #{ status: "end", remaining_time: "0", initial_time: "14" });
}

// 0x92 energy decodes as big-endian Wh (rec[16] high, rec[17] low)
fn test_energy() {
    let d = device();
    d.feed(energy_41());
    expect_props(d, #{ energy: "41" });
    d.feed(energy_272());
    expect_props(d, #{ energy: "272" });
}

// unconfirmed status-frame enum indices fall back to unknown (never a wrong number). Upstream
// overwrites the property with an unknown value; here an unknown code is not published at all.
fn test_unknown_codes_are_not_published() {
    for x in [[temp_ff(), "temp"], [spin_ff(), "spin"], [course_ff(), "course"]] {
        let d = device();
        d.feed(x[0]);
        expect_eq(d.property(x[1]), (), x[1]);
    }
}

// soil level decodes from rec[0]; light/heavy washes still decode
fn test_soil_levels() {
    let d = device();
    d.feed(soil_let());
    expect_props(d, #{ power: "true", soil: "light" });
    d.feed(soil_med());
    expect_props(d, #{ soil: "medium" });
    d.feed(soil_tung());
    expect_props(d, #{ power: "true", soil: "heavy" });
}

// 0x92 frame of unexpected length is ignored; unknown frame type and non-envelope frames are ignored
fn test_other_frames_are_ignored() {
    let d = device();
    for x in ["aa00200a0092000196000100ec0080000300bb", "aa00200a005a0001020304050600bb", "aa0720e90a91bb", "001122"] {
        d.feed(x);
    }
    expect_eq(d.property("status"), ());
    expect_eq(d.property("power"), ());
}

// 0x92 standby frame (record B leads 0x00 with status 0x00) decodes power OFF
fn test_standby_is_off() {
    let d = device();
    d.feed(washing());
    expect_props(d, #{ power: "true", remaining_time: "14" });
    d.feed(off());
    expect_props(d, #{ power: "false", status: "off", remaining_time: "0", initial_time: "0" });
}

// OFF needs BOTH soil==0 and status==0 — a soil-led frame with a zero status stays running
fn test_off_needs_soil_and_step_zero() {
    let d = device();
    d.feed(washing_step_0());
    expect_props(d, #{ power: "true", status: "running" });
    d.feed(off());
    expect_props(d, #{ power: "false", status: "off" });
}

// a 0x00-soil-led frame with status != 0 is powered ON, never OFF (rec[20] is the discriminator)
fn test_spin_only_is_running() {
    let d = device();
    d.feed(spin_only());
    expect_props(d, #{ power: "true", status: "detecting" });
}

// 0x41 door snapshot decodes open/closed from buf[18]
fn test_door() {
    let d = device();
    d.feed(door_closed_f());
    expect_props(d, #{ door: "false" });
    d.feed(door_open_f());
    expect_props(d, #{ door: "true" });
    d.feed(door_closed_f());
    expect_props(d, #{ door: "false" });
}

// 0x41 with an uninitialised door byte (0x05 at power-on) holds the last state
fn test_door_uninitialised_holds() {
    let d = device();
    d.feed(door_open_f());
    expect_props(d, #{ door: "true" });
    d.feed(door_uninit());
    expect_props(d, #{ door: "true" });
}

// 0x92 status maps spin index 6 -> 1000 rpm and 8 -> 1200 rpm
fn test_spin_1000_1200() {
    let d = device();
    d.feed(spin1000());
    expect_props(d, #{ spin: "1000" });
    d.feed(spin1200());
    expect_props(d, #{ spin: "1200" });
}

// 0x92 record B decodes EzDispense enable flags (detergent and softener independently)
fn test_dispenser_flags() {
    let d = device();
    d.feed(det_on());
    expect_props(d, #{ detergent_dispenser: "true", softener_dispenser: "false" });
    d.feed(soft_on());
    expect_props(d, #{ detergent_dispenser: "false", softener_dispenser: "true" });
}

// 0x92 record B decodes EzDispense doses as literal mL (detergent rec[31], softener rec[32])
fn test_dispenser_doses() {
    let d = device();
    d.feed(det_dose120());
    expect_props(d, #{ detergent_dose: "120", softener_dose: "30" });
    d.feed(soft_dose120());
    expect_props(d, #{ softener_dose: "120", detergent_dose: "45" });
}

// 0x92 decodes newly-mapped course codes (rec[4])
fn test_courses() {
    let d = device();
    d.feed(eco());
    expect_props(d, #{ course: "eco_40_60" });
    d.feed(delikat());
    expect_props(d, #{ course: "delicate" });
    d.feed(mikroplast());
    expect_props(d, #{ course: "microplastic_care" });
}

// 0x92 decodes rinse (skyl) level from rec[26]
fn test_rinse() {
    let d = device();
    d.feed(skyl_none());
    expect_props(d, #{ rinse: "none" });
    d.feed(skyl_plus());
    expect_props(d, #{ rinse: "rinse_plus" });
    d.feed(skyl_hold());
    expect_props(d, #{ rinse: "normal_hold" });
}

// 0x92 record B decodes option bitflags
fn test_options() {
    let d = device();
    d.feed(soil_med());
    expect_props(d, #{ pre_wash: "false", turbo_wash: "false", steam: "false" });
    d.feed(forvask_on());
    expect_props(d, #{ pre_wash: "true", turbo_wash: "false" });
    d.feed(turbowash_on());
    expect_props(d, #{ turbo_wash: "true", pre_wash: "false" });
    d.feed(steam_on());
    expect_props(d, #{ steam: "true" });
}

// 0x92 record B decodes child_lock (rec[36]&0x20) and remote_start (rec[36]&0x10)
fn test_child_lock_and_remote_start() {
    let d = device();
    d.feed(child_lock_on());
    expect_props(d, #{ child_lock: "true", remote_start: "false" });
    d.feed(remote_start_on());
    expect_props(d, #{ child_lock: "false", remote_start: "true" });
    d.feed(run_child_remote());
    expect_props(d, #{ status: "washing", child_lock: "true", remote_start: "true" });
}

// flags publish in standby too (rec[36] read before the OFF short-circuit)
fn test_flags_in_standby() {
    let d = device();
    d.feed(run_child_remote());
    expect_props(d, #{ child_lock: "true" });
    d.feed(off());
    expect_props(d, #{ power: "false", child_lock: "false", remote_start: "false" });
}

// 0x92 record B decodes tub_clean_count / washes-since-drum-clean (rec[27]) in both run and standby
fn test_drum_clean_counter() {
    let d = device();
    d.feed(run_child_remote());
    expect_props(d, #{ cycles: "1" });
    d.feed(cycle_end());
    expect_props(d, #{ power: "false", cycles: "2" });
}

// 0x00-soil-led back-half phases decode as running (rinse/spin/end + spin-only)
fn test_back_half_phases() {
    let d = device();
    d.feed(rinse());
    expect_props(d, #{ power: "true", status: "rinsing", remaining_time: "32", spin: "1400", course: "ai_wash" });
    d.feed(spinning());
    expect_props(d, #{ power: "true", status: "spinning", remaining_time: "12" });
    d.feed(spin_only());
    expect_props(d, #{ power: "true", course: "spin_only", spin: "400", remaining_time: "8" });
}

// sub-step status codes map to their phase (0x03/0x25 Detecting, 0x26 Washing, 0x27 Rinsing)
fn test_sub_steps() {
    let d = device();
    d.feed(step_03());
    expect_props(d, #{ status: "detecting" });
    d.feed(step_25());
    expect_props(d, #{ status: "detecting" });
    d.feed(step_26());
    expect_props(d, #{ status: "washing" });
    d.feed(step_27());
    expect_props(d, #{ status: "rinsing" });
}
