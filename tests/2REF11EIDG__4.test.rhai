import "runtime_test" as runtime;

// Tests of 2REF11EIDG__4.rhai (fridge), ported from upstream rethink's test suite (commit
// 0e57069; real captures; writes are the commands the LG app sent). Expected values and writes are what upstream's driver
// publishes and sends for the same input.

fn frame_fridge_38() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000206060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000086BB" }
fn frame_freezer_1() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000207050102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000086BB" }
fn frame_ice_plus_on() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000207060202000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000080BB" }
fn frame_door_open() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000207060102000001000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000080BB" }
fn frame_smart_learner_on() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000207060102000000000001FFFFFF00FFFF01FFFFFFFFFFFFFF02150505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF000080BB" }
fn frame_sabbath_on() { "AA8E10EC0207060102000000000001FFFFFF00FFFF00FFFFFFFFFFFFFF021A0505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00000207060102000000000001FFFFFF01FFFF00FFFFFFFFFFFFFF021A0505FF00000101FF6464FFFFFF01FF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0078FF00008ABB" }
fn frame_usage_gallon() { "AA3810C5030801000000000302000000000003000000000111000000018A120000000000130000000010210ECC001E8A2201A70001A7E7BB" }

fn last(d) { let s = d.sent(); hex_encode_upper(s[s.len() - 1]) }

fn test_frame_fridge_38() {
    let d = device();
    d.feed(frame_fridge_38());
    expect_props(d, #{ fridge_setpoint: "38", freezer_setpoint: "0", door: "false", ice_plus: "false", sabbath_mode: "false", smart_learner: "false", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_freezer_1() {
    let d = device();
    d.feed(frame_freezer_1());
    expect_props(d, #{ fridge_setpoint: "37", freezer_setpoint: "1", door: "false", ice_plus: "false", sabbath_mode: "false", smart_learner: "false", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_ice_plus_on() {
    let d = device();
    d.feed(frame_ice_plus_on());
    expect_props(d, #{ fridge_setpoint: "37", freezer_setpoint: "0", door: "false", ice_plus: "true", sabbath_mode: "false", smart_learner: "false", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_door_open() {
    let d = device();
    d.feed(frame_door_open());
    expect_props(d, #{ fridge_setpoint: "37", freezer_setpoint: "0", door: "true", ice_plus: "false", sabbath_mode: "false", smart_learner: "false", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_smart_learner_on() {
    let d = device();
    d.feed(frame_smart_learner_on());
    expect_props(d, #{ fridge_setpoint: "37", freezer_setpoint: "0", door: "false", ice_plus: "false", sabbath_mode: "false", smart_learner: "true", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_sabbath_on() {
    let d = device();
    d.feed(frame_sabbath_on());
    expect_props(d, #{ fridge_setpoint: "37", freezer_setpoint: "0", door: "false", ice_plus: "false", sabbath_mode: "true", smart_learner: "false", fresh_air_filter: "100", water_filter: "100" });
}

fn test_frame_usage_gallon() {
    let d = device();
    d.feed(frame_usage_gallon());
    expect_props(d, #{ water_dispensed: "7.818" });
}

fn test_start() {
    let d = device();
    d.start();
    expect_eq(d.sent().len(), 1);
    if d.sent().len() > 0 { expect_eq(last(d), "AA0EF0ED1211010000010400EBBB"); }
}

fn test_writes_match_upstream() {
    let d = device();
    d.start();
    d.feed(frame_fridge_38());
    for w in [
        ["fridge_setpoint", "38", "AA7CF017FF06FFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFA5BB"],
        ["freezer_setpoint", "1", "AA7CF017FFFF05FFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBABB"],
        ["ice_plus", "true", "AA7CF017FFFFFF02FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBEBB"],
        ["ice_plus", "false", "AA7CF017FFFFFF01FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB"],
        ["smart_learner", "true", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF01FFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB"],
        ["smart_learner", "false", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBCBB"],
        ["sabbath_mode", "true", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFF01FFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBFBB"],
        ["sabbath_mode", "false", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFFFFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFBCBB"],
        ["fresh_air_filter_reset", "PRESS", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFF64FFFFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFF18BB"],
        ["water_filter_reset", "PRESS", "AA7CF017FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF000000FFFF00FFFFFFFF00FFFFFFFF64FFFFFFFF00FFFFFF1EFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF0AFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFF18BB"],
    ] {
        d.set(w[0], w[1]);
        expect_eq(last(d), w[2]);
    }
}

fn test_unknown_and_read_only_writes_are_rejected() {
    let d = device();
    d.start();
    d.feed(frame_fridge_38());
    let n = d.sent().len();
    d.set("does_not_exist", "1");
    d.set("door", "true");
    expect_eq(d.sent().len(), n);
    expect(d.event("reject") != (), "rejects are published");
}

fn test_other_frames_are_ignored() {
    let d = device();
    d.feed("001122");
    d.feed("AA08109901020304BB");
    expect_eq(d.property("door"), ());
}

fn test_the_usage_report_is_acked_as_the_cloud_does_and_status_records_are_not() {
    let d = device();
    d.feed(frame_fridge_38());
    expect_eq(d.clips().len(), 0);
    d.feed(frame_usage_gallon());
    let clips = d.clips();
    expect_eq(clips.len(), 1);
    expect_eq(clips[0].cmd, "ack");
    expect_eq(clips[0].data, "AA08F000C5043EBB");
}
